# syntax=docker/dockerfile:1.7
FROM rust:1.94.0-bookworm@sha256:365468470075493dc4583f47387001854321c5a8583ea9604b297e67f01c5a4f

WORKDIR /app
COPY rust/ ./rust/

ENV STIRLING_ENGINE_HOST=0.0.0.0 \
    STIRLING_ENGINE_PORT=5001

EXPOSE 5001

CMD ["cargo", "run", "--manifest-path", "rust/Cargo.toml", "-p", "stirling-ai-engine", "--bin", "stirling-ai-engine", "--locked"]
